{
  "product": "claude-exelo",
  "providers": {
    "crawler": "local-playwright",
    "contentParser": "@mozilla/readability+turndown",
    "businessData": "openstreetmap-overpass"
  },
  "crawler": {
    "browser": "chromium",
    "maxPages": 8,
    "sameOriginOnly": true,
    "userAgent": "ClaudeExeloResearchBot/0.1"
  },
  "openStreetMap": {
    "geocoder": "https://nominatim.openstreetmap.org/search",
    "overpass": "https://overpass-api.de/api/interpreter",
    "defaultRadiusMeters": 10000,
    "attribution": "© OpenStreetMap contributors"
  },
  "scoring": {
    "version": 1,
    "method": "evidence-weighted-opportunity-triage",
    "dimensions": ["fit", "market-proof", "conversion-friction", "website-quality"],
    "disclaimer": "Not a prediction of revenue, rankings, or conversion."
  }
}
