{
  "product": "exelo-agentic-research",
  "providers": {
    "crawler": "built-in-fetch",
    "businessData": "google-places"
  },
  "crawler": {
    "maxPages": 8,
    "sameOriginOnly": true,
    "userAgent": "ExeloResearchBot/0.1"
  },
  "googlePlaces": {
    "endpoint": "https://places.googleapis.com/v1/places:searchText",
    "requiredEnv": "GOOGLE_MAPS_API_KEY",
    "fieldMask": ["places.id", "places.displayName", "places.formattedAddress", "places.nationalPhoneNumber", "places.websiteUri", "places.rating", "places.userRatingCount", "places.businessStatus", "places.primaryType", "places.googleMapsUri"]
  }
}
